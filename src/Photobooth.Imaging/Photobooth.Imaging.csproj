<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Photobooth.Core\Photobooth.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <!-- GIF encoding only; everything else is SkiaSharp, which can decode an
         animated GIF but not write one.

         Pinned to 3.x deliberately. ImageSharp 4 requires a purchased licence key
         and warns on every build without one; 3.x is the Six Labors Split
         License, which is free for a business this size. Revisit if the booth
         ever turns over enough to need a licence anyway. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SkiaSharp" Version="4.151.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- CoverCrop is the crop maths, worth testing directly, but not worth putting
       on the public API just for that. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Photobooth.Imaging.Tests" />
  </ItemGroup>

</Project>
